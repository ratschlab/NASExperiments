# Simulated Zymo communities (upstream benchmarks): enrich Community 1.
: ${DATASET:=zymo}
: ${REF:=/data/SimulatedDatasets/Zymo/Refs1.fasta}
: ${TARGETS:='[]'}

# Tool settings: the values used before the HXB2 sweep (templates need them all).
# mg seed length 19 assumes metagraph's default equals the k19 index; mm values are mappy's defaults.
: ${MM_MIN_CHAIN_SCORE:=40}; : ${MM_MIN_CNT:=3}
: ${MG_DISCOVERY_FRACTION:=0.03}
: ${MG_MIN_EXACT_MATCH:=0.1}; : ${MG_MIN_SEED_LENGTH:=19}
: ${SP_K:=4}; : ${SP_W:=11}; : ${SP_WINDOW:=150}
: ${RB_KMER_SIZE:=17}; : ${RB_ERROR_RATE:=0.1}; : ${RB_CHUNK_LENGTH:=250}
: ${CN_THRESHOLD:=0.15}
