# HIV HXB2 amplicon experiment (GridION runs 2026-03-25 mappy_rs, 2026-03-30 metagraphRF):
# enrich HXB2_IN in the target half of the flow cell.
# Sourced by scripts/render_configs.sh before the site file.
: ${DATASET:=hxb2}
# reference the indices are built from (scripts/build_experiment_indices.sh):
# a copy under data/refs/ (e.g. on the GridION) or the original run data
if [ -f "$EXPDIR/data/refs/HXB2/HXB2_IN.fasta" ]; then
    : ${REF:=$EXPDIR/data/refs/HXB2/HXB2_IN.fasta}
fi
: ${REF:=/data/uzh_ont/2026_03/refs/HXB2/HXB2_IN.fasta}
# TOML list of target contigs for the target region
: ${TARGETS:='["HXB2_IN"]'}

# Tool settings from the HXB2 sweep, 2026-11-27 (run 2 control reads, 6,000 samples).
# Tuned for a 1.4 kb amplicon target at ~3.5-5% other reads kept; not for large references.
# Comments: targets kept / other reads kept, then the previous setting's numbers.
# Index settings (build_experiment_indices.sh): rebuild indices after changing.

# mm: k11 w5 index, looser chaining: 74%/3.6% (k15 w10, 40/3: 47%/1.9%)
: ${MM_K:=11}; : ${MM_W:=5}
: ${MM_MIN_CHAIN_SCORE:=10}; : ${MM_MIN_CNT:=2}

# cl: k13 index: 43%/1.7% (k15: 29%/1.4%); k >= 16 segfaults
: ${CL_K:=13}

# mg: k15 index; query 74%/3.7% (k19, 0.03: 48%/1.8%); map 77%/4.8% (k19, 0.1: 53%/2.2%)
: ${MG_K:=15}
: ${MG_DISCOVERY_FRACTION:=0.01}
: ${MG_MIN_EXACT_MATCH:=0.0}; : ${MG_MIN_SEED_LENGTH:=15}

# sp: K4 W8 index, window 100: 68%/4.5% (W11, 150: 54%/3.0%)
: ${SP_K:=4}; : ${SP_W:=8}; : ${SP_WINDOW:=100}

# rb: k13 index: 73%/3.7% (k17, 0.1, 250: 69%/3.2%)
: ${RB_KMER_SIZE:=13}; : ${RB_ERROR_RATE:=0.15}; : ${RB_CHUNK_LENGTH:=400}

# cn: k13 downsample-1 index, threshold 0.05: 65%/3.1% (defaults: 10%/0.5%)
: ${CN_K:=13}; : ${CN_S:=8}; : ${CN_DOWNSAMPLE:=1}; : ${CN_WIN:=4000}; : ${CN_OVERLAP:=2}
: ${CN_THRESHOLD:=0.05}
