# HIV HXB2 amplicon experiment (GridION runs 2026-03-25 mappy_rs, 2026-03-30 metagraphRF):
# enrich HXB2_IN in the target half of the flow cell.
# Sourced by scripts/render_configs.sh before the site file.
: ${DATASET:=hxb2}
# reference the indices are built from (scripts/build_experiment_indices.sh):
# a copy under data/refs/ (e.g. on the GridION) or the original run data
if [ -f "$EXPDIR/data/refs/HXB2/HXB2_IN.fasta" ]; then
    : ${REF:=$EXPDIR/data/refs/HXB2/HXB2_IN.fasta}
fi
: ${REF:=/data/uzh_ont/2026_03/refs/HXB2/HXB2_IN.fasta}
# TOML list of target contigs for the target region
: ${TARGETS:='["HXB2_IN"]'}
