# Development server (grlab, selseq); runs MinKNOW and its dorado server like the GridION
# Sourced by scripts/render_configs.sh with EXPDIR set to the repo root.
# Values set as ${VAR:=default} can be overridden from the environment,
# e.g. THREADS=8 scripts/render_configs.sh sites/gridion.env experiments/hxb2.env
# DATASET comes from the experiment file, which is sourced first.

# MinKNOW-managed dorado basecall server: the address the running server listens
# on (its socket path differs between standalone MinKNOW and the GridION),
# else the standalone MinKNOW default
source "$EXPDIR/scripts/gridion_common.sh"
: ${BASECALL_ADDRESS:=$(dorado_address)}
: ${BASECALL_ADDRESS:=ipc:///var/lib/minknow/data/.dorado/dorado-basecall-server.sock}
# must match the flow cell/kit and a model the dorado server provides
: ${BASECALL_CONFIG:=dna_r10.4.1_e8.2_400bps_fast@v5.2.0||}

# leave cores for basecalling
: ${THREADS:=$(( $(nproc) / 2 ))}

: ${CODE_DIR:=$EXPDIR/code}
# layout written by scripts/build_experiment_indices.sh: <INDEX_DIR>/<tool>/<DATASET>.*
: ${INDEX_DIR:=$EXPDIR/tmp/$DATASET}
# ReadBouncer names the IBF after the reference file
: ${RB_IBF:=$INDEX_DIR/rb/$(basename "${REF%.*}").ibf}
# metagraphRF: graph served by `metagraph server_query` (started by run_gridion.sh)
: ${MG_SERVER_PORT:=5555}
: ${MG_GRAPH:=$INDEX_DIR/mg/$DATASET.dbg}
: ${MG_ANNO:=$INDEX_DIR/mg/$DATASET.column.annodbg}

# decision policy, file in configs/regions/
: ${REGIONS:=target_control}
